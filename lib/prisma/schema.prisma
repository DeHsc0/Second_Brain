// use prisma-8
types {
  
  Embedding1536 = pgvector.Vector(1536)

}

model User {
  id          String        @id @onCreate(uuid())
  username    String        @unique
  clerkId     String        @unique
  email       String        @unique
  collections Collections[]
  contents    Contents[]
}

model Collections {
  id          String        @id @onCreate(uuid())
  title       String
  description String
  contentType ContentType[]
  createdAt   DateTime      @default(now())
  updateAt    DateTime       @onUpdate(now())
  clerkId     String
  user        User          @relation(fields: [clerkId], references: [clerkId])
  contents    Contents[]
}

model Contents {
  id           String                @id @onCreate(uuid())
  title        String
  description  String?
  mainContent  String
  summary      String
  contentType  ContentType[]
  collectionId String
  createdAt    DateTime              @default(now())
  updateAt     DateTime               @onUpdate(now())
  embedding    Embedding1536
  clerkId      String
  user         User                  @relation(fields: [clerkId], references: [clerkId])
  collection   Collections           @relation(fields: [collectionId], references: [id] , onDelete: Cascade)
}

enum ContentType {
  WEBPAGE
  YOUTUBE
  CODE
  NOTE
}
